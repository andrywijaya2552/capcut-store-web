# Port Server (Di Pterodactyl otomatis membaca SERVER_PORT dari allocation)
PORT=3000
SERVER_PORT=3000

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Domain publik website (untuk link webhook / callback bila diperlukan)
SITE_DOMAIN=http://localhost:3000

# Flowix Payment Gateway (https://flowix.web.id) - topup saldo otomatis QRIS & Virtual Account
FLOWIX_API_KEY=your_flowix_api_key_here
FLOWIX_MERCHANT_ID=your_flowix_merchant_id_here
FLOWIX_WEBHOOK_SECRET=your_flowix_webhook_secret_here

# Catatan: Model bisnis = JASA BELI & AKTIVASI akun CapCut Pro.
